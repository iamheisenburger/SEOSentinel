{
  "name": "pentra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run bundle:video && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:wordpress": "node scripts/wordpress-fixture.mjs --test",
    "test:wordpress:mysql": "node scripts/wordpress-fixture.mjs --mysql --test",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "check:schema": "node scripts/schema-compatibility.mjs",
    "bundle:video": "remotion bundle video/index.ts --out-dir .remotion --public-dir video/public --log=error"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@clerk/backend": "^3.16.0",
    "@clerk/nextjs": "^7.7.0",
    "@clerk/themes": "^2.4.57",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "@remotion/vercel": "4.0.542",
    "@types/nodemailer": "^8.0.1",
    "@vercel/sandbox": "1.6.0",
    "convex": "^1.30.0",
    "date-fns": "^4.1.0",
    "imapflow": "^1.7.6",
    "lucide-react": "^0.575.0",
    "mailparser": "^3.9.20",
    "next": "^16.3.3",
    "nodemailer": "^9.1.1",
    "openai": "^6.10.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remotion": "4.0.542",
    "tldts": "^7.4.10",
    "unified": "^11.0.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
